{
  "name": "tibia-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "check:env": "node --env-file-if-exists=.env src/check-env.js",
    "deploy:commands": "node --env-file-if-exists=.env src/deploy-commands.js",
    "test": "node --test"
  },
  "dependencies": {
    "discord.js": "14.28.1"
  }
}
